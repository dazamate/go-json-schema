       "@type": "Question",
       "name": "What length are the necklace chains?",
       "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most listings use a 50 cm chain. Some are 45 cm, and a few are 55 cm or 60 cm. The chain length is in each product description."
       }
      },
      {
       "@type": "Question",
       "name": "What are the necklaces made of?",
       "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mostly silver-plated alloy, with some stainless steel, glass and faux stones. Each description lists the pendant and chain material."
       }
      },
