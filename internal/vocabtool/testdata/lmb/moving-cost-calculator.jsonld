  {
   "@id": "http://localhost:8080/moving-cost-calculator/#faq",
   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Start with a moving cost calculator: enter both ZIP codes, your home size, the date and any extras to get a range. A studio apartment moved 10 road miles, off peak with no stairs or extras, comes to $280–$740. Then add the costs movers don't charge for, such as tips, supplies and travel, and ask movers for written estimates to firm it up."
     },
     "name": "How do you estimate the cost of a move?"
    },
