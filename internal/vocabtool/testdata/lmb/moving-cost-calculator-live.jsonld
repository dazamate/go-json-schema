    {
     "@id": "https://liftmyboxes.com/moving-cost-calculator/#exact",
     "@type": "HowTo",
     "description": "Moving cost calculator: an estimate tells you what to expect. These steps make sure the final bill matches it.",
     "name": "Five ways to get a quote you can count on",
     "step": [
      {
       "@type": "HowToStep",
       "name": "List your big items",
       "position": 1,
       "text": "Beds, sofas, appliances and anything heavy. They drive weight, crew size and time."
      },
      {
       "@type": "HowToStep",
       "name": "Ask for a survey",
       "position": 2,
       "text": "An in-home or video walk-through gives the mover what they need to firm up the price."
      },
      {
       "@type": "HowToStep",
       "name": "Get it in writing",
       "position": 3,
       "text": "Know whether your estimate is binding or non-binding before you sign anything."
      },
      {
       "@type": "HowToStep",
       "name": "Check the USDOT number",
       "position": 4,
       "text": "For interstate moves, confirm the mover is registered with the FMCSA."
      },
      {
       "@type": "HowToStep",
       "name": "Choose your coverage",
       "position": 5,
       "text": "Decide between basic released value and full value protection before moving day."
      }
     ]
    },
