  {
   "@id": "http://localhost:8080/how-much-do-movers-cost-bay-area/#faq",
   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The hourly rate depends more on the mover than the city, but an Oakland or East Bay move often takes fewer hours: more driveways, easier parking and fewer steep blocks. A San Francisco flat with front steps and no curb space takes longer, so how much do movers cost Bay Area renters tends to be higher in the city even at the same rate. Enter both addresses in the calculator to compare."
     },
     "name": "Is moving in Oakland cheaper than in San Francisco?"
    },
    {
     "@type": "Question",
     "acceptedAnswer": {
      "@type": "Answer",
